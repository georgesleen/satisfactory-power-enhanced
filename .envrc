use flake .

hooks_directory=$(git rev-parse --git-path hooks 2>/dev/null) || hooks_directory=
if [ -n "$hooks_directory" ]; then
  case "$hooks_directory" in
    /*) ;;
    *) hooks_directory="$(pwd)/$hooks_directory" ;;
  esac
  hook="hooks/pre-push"
  target="$hooks_directory/pre-push"
  if ! mkdir -p "$hooks_directory" 2>/dev/null; then
    printf 'direnv: warning: cannot create hooks directory: %s\n' "$hooks_directory" >&2
  elif [ -e "$target" ] || [ -L "$target" ]; then
    link_target=$(readlink "$target" 2>/dev/null)
    case "$link_target" in
      */hooks/pre-push)
        if ! cmp -s "$target" "$hook"; then
          printf 'direnv: warning: existing hook is not managed by this checkout: %s\n' "$target" >&2
        fi
        ;;
      *)
        printf 'direnv: warning: existing hook is not managed by this checkout: %s\n' "$target" >&2
        ;;
    esac
  else
    source=$(realpath --relative-to="$hooks_directory" "$hook" 2>/dev/null)
    if [ -n "$source" ] && ln -s "$source" "$target" 2>/dev/null; then
      printf 'direnv: installed git hook: pre-push\n'
    else
      printf 'direnv: warning: could not install hook: %s\n' "$target" >&2
    fi
  fi
else
  printf 'direnv: warning: cannot resolve Git hooks directory\n' >&2
fi
